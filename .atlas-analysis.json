{
  "projectType": "sdk-library",
  "projectName": "cap-std",
  "projectDescription": "A capability-based version of the Rust standard library that sandboxes filesystem, networking, and time access using unforgeable resource handles instead of ambient authority.",
  "theme": "luma",
  "primaryColor": "#469eab",
  "lightColor": "#1dd3d9",
